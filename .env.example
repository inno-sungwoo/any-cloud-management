# =============================================================================
# any-cloud-management — 환경 변수 템플릿
# =============================================================================
# 사용법:
#   1) 이 파일을 .env 로 복사:  cp .env.example .env
#   2) 필요한 값을 본인 환경에 맞게 수정 (특히 비밀번호)
#   3) docker compose / setup.sh 실행 — docker compose가 .env를 자동 로드
#
# 주의:
#   - 모든 변수가 docker-compose.yml에서 ${VAR:-default} 형태로 참조되므로
#     .env가 없어도 default 값으로 정상 동작합니다 (개발 환경 한정)
# =============================================================================

# ─── Spring Profile ──────────────────────────────────────────────────────────
# Docker 컨테이너 실행 시 docker (Dockerfile ENV 와 동일).
# 로컬 직접 실행 시에는 ./gradlew bootRun --args='--spring.profiles.active=local'
SPRING_PROFILES_ACTIVE=docker

# ─── DB (MariaDB) ────────────────────────────────────────────────────────────
# DATABASE_* 만 설정하면 anycloud-db 컨테이너의 MYSQL_* 와 자동 동기화됨
# (docker-compose.yml 이 ${DATABASE_USERID} 등으로 참조)
DATABASE_HOST=anycloud-db
DATABASE_PORT=3306
DATABASE_NAME=aipaas
DATABASE_USERID=anycloud
DATABASE_USERPASS=anycloud

# DB root 비밀번호 (운영 필수 변경)
# 주의: 기존 db_data/ 볼륨에는 적용되지 않음 — 변경 시 docker compose down -v + db_data/ 삭제 필요
MYSQL_ROOT_PASSWORD=yourP@ssW0rds

# ─── Kubernetes ──────────────────────────────────────────────────────────────
# kubeconfig 경로 (컨테이너 내부). docker-compose.yml volumes 마운트와 일치해야 함
# Docker backend 기반
# 기본값: /app/config/kubeconfig (./config 디렉토리가 마운트됨)
KUBECONFIG_PATH=/app/config/kubeconfig
# Local backend 기반
# KUBECONFIG_PATH=../config/kubeconfig


# ─── 모니터링 (Prometheus) ───────────────────────────────────────────────────
# 새 cluster row INSERT 시 monit_server_url 컬럼 초기값 (1회성)
# 이미 등록된 cluster의 URL 변경은 DB UPDATE로 직접 수행해야 함
# Docker backend 기반
MONIT_DEFAULT_URL=http://host.docker.internal:9090
# Local backend 기반
# MONIT_DEFAULT_URL=http://localhost:9090

# ─── 타임존 ──────────────────────────────────────────────────────────────────
TZ=Asia/Seoul

# ─── (선택) 프론트엔드 ────────────────────────────────────────────────────────
# 백엔드를 다른 호스트/포트로 옮길 때만 변경
# Docker backend 기반
VITE_API_BASE_URL=http://anycloud-backend:8888/api/v1
# local backend 기반
# VITE_API_BASE_URL=http://localhost:8888/api/v1
